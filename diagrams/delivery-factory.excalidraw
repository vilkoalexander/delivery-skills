    {
      "id": "566fd5e4",
      "type": "text",
      "x": 2104,
      "y": 112,
      "width": 448.0,
      "height": 87.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 340517,
      "version": 1,
      "versionNonce": 4503347,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "A skipped step is printed as skipped, never counted as a pass.\nA step that could not run fails the gate.\nRevert check runs only when the chunk changed tests and source.\nNot in the gate: credentials (your CI); suppressions, `as any`\nand complexity (your ESLint config, through the lint step).",
      "originalText": "A skipped step is printed as skipped, never counted as a pass.\nA step that could not run fails the gate.\nRevert check runs only when the chunk changed tests and source.\nNot in the gate: credentials (your CI); suppressions, `as any`\nand complexity (your ESLint config, through the lint step).",
      "rawText": "A skipped step is printed as skipped, never counted as a pass.\nA step that could not run fails the gate.\nRevert check runs only when the chunk changed tests and source.\nNot in the gate: credentials (your CI); suppressions, `as any`\nand complexity (your ESLint config, through the lint step).",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
